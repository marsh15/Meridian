# Copy to .env (services/api) or export in the process environment.
# Everything here can also be set as plain env vars — .env is a convenience
# for local dev; deployments should inject real secrets, not commit them.

# Postgres (dev default targets the docker-compose instance on :5434)
DATABASE_URL=postgresql+asyncpg://meridian:meridian@localhost:5434/meridian

# Set to true in production so the session cookie is only sent over HTTPS
COOKIE_SECURE=false

# Comma-separated allow-list; production should be exactly the deployed origin
CORS_ORIGINS=http://localhost:3001

# Kafka broker for the outbox relay + consumers
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Durable market-lifecycle workflows: server address, and where the API
# sends resolution requests. SETTLEMENT_MODE=inline runs settlement in the
# request instead (tests, or dev without a worker).
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=meridian-lifecycle
SETTLEMENT_MODE=temporal

# Redis (phase 5): rate limits, markets-list cache, SSE tick fan-out.
# Empty string disables all three — every use fails open (ADR 0009).
REDIS_URL=redis://localhost:6399/0
AUTH_REQUESTS_PER_MINUTE=10
ORDERS_PER_MINUTE=30
MARKET_CREATES_PER_HOUR=10

# OTLP endpoint for traces + metrics (compose collector). Empty = off.
OTLP_ENDPOINT=http://localhost:4319
